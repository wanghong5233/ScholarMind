# Application Configuration
VITE_TITLE=ScholarMind
# 推荐：开发环境走 Vite 代理
VITE_API_BASE=/api
VITE_ENABLE_ADMIN_UI=true

# Demo 部署建议：
# VITE_API_BASE=https://<your-backend-domain>/api
# VITE_DEMO_ENTRY_ENABLED=true   # 根路径 / 重定向到 /demo 免登录入口
# （当 VITE_API_BASE 为绝对地址时，Doc Studio / Deep Research 的 base 会自动派生，一般无需单独配置）
# VITE_DOC_STUDIO_BASE=https://<your-backend-domain>/api/doc-studio
# VITE_DEEP_RESEARCH_BASE=https://<your-backend-domain>/api/deep-research
# VITE_ENABLE_ADMIN_UI=false
# BGE Reranker 服务 Dockerfile (GPU 版本)
# 使用 NVIDIA CUDA Runtime 基础镜像，确保 GPU 支持
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

WORKDIR /app

# 1. 配置国内镜像源（加速下载）
RUN sed -i 's@http://.*archive.ubuntu.com@https://mirrors.tuna.tsinghua.edu.cn@g' /etc/apt/sources.list && \
    sed -i 's@http://.*security.ubuntu.com@https://mirrors.tuna.tsinghua.edu.cn@g' /etc/apt/sources.list

# 2. 安装系统依赖
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    python3 \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 3. 配置 pip 国内镜像源
RUN pip3 config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip3 config set global.extra-index-url "https://mirrors.cernet.edu.cn/pypi/web/simple https://pypi.mirrors.ustc.edu.cn/simple/"

# 4. 升级 pip
RUN pip3 install --upgrade pip setuptools wheel

# 5. 安装 GPU 版本的 PyTorch（CUDA 12.1）
RUN pip3 install --no-cache-dir \
    torch==2.5.1 \
    torchvision \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cu121

# 6. 安装精排服务依赖
RUN pip3 install --no-cache-dir \
    fastapi==0.115.0 \
    uvicorn==0.31.0 \
    sentence-transformers==5.0.0 \
    transformers>=4.40.0 \
    bitsandbytes>=0.43.0 \
    pydantic==2.10.1 \
    numpy \
    huggingface_hub>=0.20.0

# 7. 复制服务代码
COPY reranker_service.py /app/reranker_service.py

# 注意：模型会在服务首次启动时自动下载（如果volume中不存在）
# 这样可以避免在Dockerfile中下载模型（因为volume挂载会覆盖容器内的文件）
# 首次调用 /rerank 接口时会触发模型下载

# 8. 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV RERANKER_MODEL_PATH=/models/bge-reranker-large
ENV RERANKER_USE_QUANTIZATION=true

# 9. 暴露端口
EXPOSE 8002

# 10. 启动服务
CMD ["uvicorn", "reranker_service:app", "--host", "0.0.0.0", "--port", "8002"]


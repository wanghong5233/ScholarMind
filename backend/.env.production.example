# ===============================================================
# ScholarMind Production Example (.env.production.example)
# 适用于：ECS 2C2G + docker-compose.prod.yml + cloudflared on ECS
# ===============================================================

# -----------------------------
# Core infrastructure
# -----------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=scholarmind
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@scholarmind_db:5432/scholarmind
# 大批量上传时防止默认连接池耗尽（QueuePool size 5/overflow 10）。
SM_DB_POOL_SIZE=12
SM_DB_MAX_OVERFLOW=24
SM_DB_POOL_TIMEOUT_SECS=30
SM_DB_POOL_RECYCLE_SECS=1800
SM_DB_POOL_PRE_PING=true

REDIS_HOST=scholarmind_redis
REDIS_PORT=6379
REDIS_DB=0

# Host directory mounted into scholarmind_api for uploaded PDFs and parser outputs.
# Create it on ECS before starting Compose:
#   sudo mkdir -p /opt/data/scholarmind/storage && sudo chown -R $USER:$USER /opt/data/scholarmind
SM_STORAGE_ROOT=/opt/data/scholarmind/storage

# Host directory holding pre-fetched NLTK data (punkt/punkt_tab/stopwords/wordnet),
# mounted read-only into scholarmind_api at /usr/local/nltk_data.
# llama-index-core triggers nltk.download('punkt_tab' / 'stopwords') on import; ECS
# cannot reach raw.githubusercontent.com without VPN, so download must happen via
# domestic mirrors *outside* Docker build. One-time prep on ECS:
#   sudo mkdir -p /opt/data/nltk_data && sudo chown -R $USER:$USER /opt/data/nltk_data
#   bash backend/scripts/prepare_nltk_data.sh /opt/data/nltk_data
SM_NLTK_DATA_ROOT=/opt/data/nltk_data

# -----------------------------
# Security / CORS / Demo
# -----------------------------
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
SM_CORS_ALLOW_ORIGINS=https://scholarmind.wh5233.me
SM_CORS_ALLOW_ORIGIN_REGEX=
ENABLE_DEBUG_ROUTES=false
SM_ADMIN_CONSOLE_USERNAME=CHANGE_ME_ADMIN_USERNAME
SM_ADMIN_CONSOLE_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

SM_DEMO_MODE=false
SM_DEMO_ENTRY_ENABLED=true
SM_DEMO_USERNAME=testuser
SM_DEMO_ENTRY_CODE=
SM_DEMO_ENTRY_RATE_PER_MINUTE=20
SM_DEMO_TOKEN_EXPIRE_HOURS=2

# -----------------------------
# Cloudflare tunnel on ECS
# -----------------------------
CF_TUNNEL_TOKEN=CHANGE_ME_CF_TUNNEL_TOKEN
# 仅用于运维脚本或人工排查
SM_PUBLIC_HEALTH_URL=https://api-scholarmind.wh5233.me/health

# Internal service gateway targets used by the main API.
DOC_STUDIO_SERVICE_URL=http://doc_studio:8003
DEEP_RESEARCH_SERVICE_URL=http://deep_research:8004

# -----------------------------
# Vector store / parser / reranker
# -----------------------------
SM_VECTOR_STORE=pgvector
SM_PGVECTOR_TABLE=rag_chunks
SM_RERANKER_TYPE=dashscope
# 解析器顺序由代码默认值决定（"llamaparse,unstructured_api,pymupdf"）。
# 不要在这里显式声明：本地 .env 与 prod 容易写漂，反而成为偶发 bug 来源。
# 仅在排查 parser 质量问题时临时覆盖。
SM_REMOTE_PARSER_STRICT_FAIL=true
SM_REMOTE_PARSER_REQUIRE_PAGE=true
SM_REMOTE_PARSER_REQUIRE_BBOX=true

# 低成本演示默认关闭重服务
SM_GROBID_ENABLED=false
SM_MINERU_MODE=http
SM_MINERU_ENDPOINT=
SM_MINERU_STRICT_FAIL=false
SM_RERANKER_ENDPOINT=

# -----------------------------
# LLM / Embedding / external APIs
# -----------------------------
# 业务关键：以下 11 项必须与 backend/.env（本地）保持一致，否则本地复现 ECS bug 会失败。
# 维护规则见 docs/LOW_COST_CLOUD_DEPLOYMENT_MANUAL.md > "本地↔Prod 配置对齐表"。
SM_LLM_TYPE=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-5.2

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen3-max
SM_DASHSCOPE_RERANK_MODEL=qwen3-rerank

# 全局禁用 qwen-plus / qwen-turbo（意图识别 / 摘要不稳定 → RAG 路由错位）。
# 主答用 gpt-5.2，功能链路（翻译 / Multi-Query / HyDE / 意图识别 / 摘要 / 图谱）用 gpt-5-mini。
SM_LLM_MODEL_ANSWER=gpt-5.2
SM_LLM_MODEL_AUX=gpt-5-mini
SM_LLM_MODEL_GRAPH=gpt-5-mini
SM_LLM_MODEL_SUMMARY=gpt-5-mini
SM_LLM_POLICY_ENABLED=true
SM_LLM_POLICY_VERSION=v1
SM_LLM_POLICY_MANIFEST_PATH=/shared/llm_policy/llm_policy.v1.json
SM_LLM_POLICY_TASK_ANSWER=app.answer
SM_LLM_POLICY_TASK_AUX=app.aux
SM_LLM_POLICY_TASK_SUMMARY=app.summary
SM_LLM_POLICY_TASK_COMPRESSION=app.compression
SM_LLM_POLICY_TASK_REWRITE=app.rewrite
SM_LLM_POLICY_TASK_TRANSLATE=app.translate
SM_LLM_POLICY_TASK_HYDE=app.hyde
SM_LLM_POLICY_TASK_GRAPH=app.graph
SM_LLM_POLICY_TASK_FACT_EXTRACTION=app.fact_extraction
SM_LLM_POLICY_TASK_EQUATION_DESCRIPTION=app.equation_description

SM_EMBEDDER_TYPE=dashscope
SM_EMBEDDING_MODEL=text-embedding-v3
SM_EMBEDDING_DIMENSIONS=1024
SM_EMBEDDING_MAX_BATCH_SIZE=10

SEMANTIC_SCHOLAR_API_KEY=
ENABLE_WEB_SEARCH=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
# 兼容旧变量名：使用 Tavily 时可只填 WEB_SEARCH_API_KEY 或 TAVILY_API_KEY 其中一个。
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_SEARCH_BASE_URL=https://api.tavily.com/search
WEB_SEARCH_MAX_RESULTS=8
SM_LLAMA_PARSE_API_KEY=
SM_LLAMA_PARSE_BASE_URL=https://api.cloud.llamaindex.ai
SM_UNSTRUCTURED_API_KEY=
SM_UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general

# -----------------------------
# Chunking / retrieval defaults
# -----------------------------
SM_LAYOUT_AWARE_CHUNKING_ENABLED=true
SM_LAYOUT_SEMANTIC_SPLIT_ENABLED=true
SM_LAYOUT_SEMANTIC_MIN_CHARS=1800
SM_SEMANTIC_CHUNKING_ENABLED=true

# RAG topK：受 MIN=4 / MAX=8 夹紧。学术论文场景给上限 8。
SM_RAG_TOPK=8
SM_RETRIEVE_PAGE_SIZE=8
SM_ADAPTIVE_RETRIEVAL_ENABLED=true
SM_ADAPTIVE_RETRIEVAL_ROLLOUT_PERCENT=100
SM_ADAPTIVE_RETRIEVAL_ROLLOUT_KEY="adaptive_retrieval_v1"
SM_ADAPTIVE_RETRIEVAL_SHADOW_ENABLED=false
SM_ADAPTIVE_RETRIEVAL_MIN_CONFIDENCE=0.75

# shared policy (doc_studio + deep_research)
LLM_POLICY_ENABLED=true
LLM_POLICY_VERSION=v1
LLM_POLICY_MANIFEST_PATH=/shared/llm_policy/llm_policy.v1.json
LLM_POLICY_TASK_ASK=docstudio.ask
LLM_POLICY_TASK_GUARDRAIL=docstudio.guardrail
LLM_POLICY_TASK_ANALYSIS=docstudio.analysis
LLM_POLICY_TASK_ANSWER_WITHOUT_EDIT=docstudio.answer_without_edit
LLM_POLICY_TASK_RAG_SUMMARY=deepresearch.rag_summary
LLM_POLICY_TASK_DECISION=deepresearch.decision
LLM_POLICY_TASK_REPORT=deepresearch.report
LLM_POLICY_TASK_REPORT_SECTION=deepresearch.report_section
SM_RELEVANCE_GATE_ENABLED=true
SM_RELEVANCE_GATE_THRESHOLD=0.3

SM_ASK_TIMEOUT_SECS=240
SM_ASK_RATE_LIMIT_PER_MINUTE=60
SM_CRITICALQ_RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_SIZE_MB=50

# -----------------------------
# Runtime parity guardrails (must match local debug baseline)
# -----------------------------
SM_LLM_REQUEST_TIMEOUT_SECS=60
SM_RERANKER_FALLBACK_TO_DASHSCOPE=true
SM_GRAPH_ENTITY_VARIANT_FALLBACK=true
SM_HYDE_FALLBACK_ENABLED=true
SM_STM_EMBED_MISSING_ON_READ=false
SM_LTM_EMBED_MISSING_ON_READ=false
SM_FAST_MODE_AUTO_TRANSLATE=false
SM_FAST_MODE_MQ_NUM=1
SM_FAST_MODE_HYDE_ENABLED=false
SM_FAST_MODE_RERANK_ENABLED=false
SM_FAST_MODE_MAX_VARIANTS=1
SM_FAST_MODE_RECALL_SOURCES=bm25,vector
SM_FAST_MODE_RECALL_MULTIPLIER=1
SM_FAST_MODE_CHANNEL_TOPK=12
SM_ES_CLIENT_TIMEOUT_SECS=60
SM_ES_SEARCH_TIMEOUT_SECS=20
SM_ES_SEARCH_RETRY_TIMES=1
SM_UNSTRUCTURED_STRATEGY=hi_res
SM_UNSTRUCTURED_TIMEOUT_SECS=180
SM_LLAMA_PARSE_TIMEOUT_SECS=120
SM_LLAMA_PARSE_POLL_INTERVAL_SECS=2
SM_LLAMA_PARSE_MAX_POLL_ATTEMPTS=60

# -----------------------------
# DeepResearch parity baseline (must match local debug baseline)
# -----------------------------
RAG_SERVICE_URL=http://scholarmind_api:8000
DATA_ROOT=/app/data/deep_research
REQUEST_TIMEOUT=120
ENABLE_SYNC_RUN=false
QUEUE_BACKEND=sqlite
MAX_ACTIVE_RUNS=2
QUEUE_MAX_PENDING=200
ENABLE_WEB_SEARCH=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
ENABLE_CODE_EXEC=true
PAPER_SEARCH_PROVIDERS=semantic_scholar,arxiv
PAPER_SEARCH_RANK_BY=hybrid
PAPER_SEARCH_MIN_PER_PROVIDER=1
PAPER_SEARCH_MAX_RESULTS=8
PAPER_SEARCH_ARXIV_MAX_RESULTS=10
PAPER_SEARCH_ARXIV_MAX_AGE_YEARS=8
PREFERRED_LLM_PROVIDER=openai
DECISION_LLM_ENABLED=true
DECISION_LLM_MODEL_NAME=
DECISION_LLM_TEMPERATURE=0.1
DECISION_LLM_MAX_TOKENS=768
REPORT_LLM_ENABLED=true
REPORT_LLM_SECTIONAL=true
STRICT_FAIL_FAST=true
MAX_TOOL_CALLS_PER_BLOCK=10
MAX_FOLLOWUP_QUERIES_PER_BLOCK=3
AGENT_DECISION_MAX_ROUNDS=3
AGENT_MIN_EVIDENCE_QUALITY_SCORE=60
FOLLOWUP_QUEUE_EXPANSION_ENABLED=false
AUTO_EXPAND_FROM_SUMMARY=false
AGENT_FAIL_FAST_ON_TOOL_ERROR=false
AGENT_USE_FOLLOWUP_AS_SEARCH_QUERY=false

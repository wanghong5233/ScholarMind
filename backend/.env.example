# ===================================================================
# ScholarMind Project Environment Variables Template (.env.example)
# ===================================================================
#
# 开发者请将此文件复制为 .env 文件，并根据你的本地开发环境修改配置。
# `cp .env.example .env`
#

# -------------------------------------------------------------------
# Section 1: 核心基础设施 (Core Infrastructure)
# -------------------------------------------------------------------

# 【必须修改】数据库连接URL
# 在本地开发时，请确保你的 PostgreSQL 服务正在运行，并修改下面的连接字符串。
DATABASE_URL=postgresql://postgres:pg123456@localhost:5432/scholarmind

# 【通常无需修改】Redis 配置
# 在本地开发时，host 通常为 'localhost'。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 【必须修改】Elasticsearch 配置
# 在本地开发时，host 通常为 'localhost'。
ES_HOST=http://localhost:9200
# 如果你的本地 ES 实例设置了密码，请填写在这里，否则留空。
ELASTIC_PASSWORD=your_es_password_here_if_any

# -------------------------------------------------------------------
# Section 2: 安全与认证 (Security & Authentication)
# -------------------------------------------------------------------

# 【必须修改】JWT 签名密钥
# 请生成一个新的密钥并替换下面的值，不要在生产环境中使用此默认值。
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=a_very_secret_and_long_random_string_for_development

# 管理后台管理员白名单（逗号分隔）
# 示例：
# SM_ADMIN_USERNAMES=alice,bob
# SM_ADMIN_USER_IDS=1,2
SM_ADMIN_USERNAMES=
SM_ADMIN_USER_IDS=

# 管理后台独立登录账号（与主站用户体系解耦）
# 示例：
# SM_ADMIN_CONSOLE_USERNAME=admin
# SM_ADMIN_CONSOLE_PASSWORD=admin123456
SM_ADMIN_CONSOLE_USERNAME=admin
SM_ADMIN_CONSOLE_PASSWORD=admin123456

# 内部服务身份白名单（仅用于 /api/internal）
# 示例：
# SM_INTERNAL_SERVICE_ALLOWLIST=doc_studio,deep_research
SM_INTERNAL_SERVICE_ALLOWLIST=doc_studio,deep_research

# DeepResearch 服务内部调用白名单（用于 /api/deep-research/admin/*）
INTERNAL_SERVICE_ALLOWLIST=scholarmind_api

# 是否保留旧版 /api/debug 路由（生产环境建议 false）
ENABLE_DEBUG_ROUTES=false

# -------------------------------------------------------------------
# Section 3: 云服务 API (Cloud Service APIs)
# -------------------------------------------------------------------

# 【按需填写】阿里云通义千问 (DashScope) API 密钥
# 仅当你希望在本地测试 'dashscope' 相关功能时才需要填写。
DASHSCOPE_API_KEY="your_dashscope_api_key_here"
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 【按需填写】Semantic Scholar API 密钥（论文在线检索）
# DeepResearch 与“知识库在线搜论文”都会复用这套能力。
SEMANTIC_SCHOLAR_API_KEY="your_semantic_scholar_api_key_here"

# 【按需填写】Web Search 配置（DeepResearch / Doc Studio）
# STRICT_FAIL_FAST=true 时，若启用 web search 但 key 缺失会直接报错（不再静默降级）。
ENABLE_WEB_SEARCH=true
WEB_SEARCH_PROVIDER="tavily"   # tavily / serper
WEB_SEARCH_API_KEY=""
# 兼容旧变量名（若已配置，可不再重复填写 WEB_SEARCH_API_KEY）
TAVILY_API_KEY=""
SERPER_API_KEY=""
WEB_SEARCH_BASE_URL="https://api.tavily.com/search"
WEB_SEARCH_MAX_RESULTS=8
# 可选：provider 原生域名筛选（Tavily 支持 include/exclude）
WEB_SEARCH_INCLUDE_DOMAINS=""
WEB_SEARCH_EXCLUDE_DOMAINS=""
# 通用质量护栏（客户端二次过滤）
WEB_SEARCH_DOMAIN_ALLOWLIST=""
WEB_SEARCH_DOMAIN_DENYLIST=""
WEB_SEARCH_BLOCKED_TERMS=""
WEB_SEARCH_MIN_QUALITY_SCORE=0.6
WEB_SEARCH_MIN_QUERY_OVERLAP=0.08
# code.exec 工具是否可用（建议保持开启，由 Agent 按需自动触发）
ENABLE_CODE_EXEC=true

# DeepResearch 论文检索策略（默认双源：Semantic Scholar + arXiv）
PAPER_SEARCH_PROVIDERS="semantic_scholar,arxiv"
PAPER_SEARCH_RANK_BY="hybrid"  # relevance / recent / citations / hybrid

# DeepResearch 决策层（开启后由 LLM 驱动反思与工具编排，而非纯启发式）
DECISION_LLM_ENABLED=true
# 留空 = 跟随 provider 默认模型（DashScope -> DASHSCOPE_MODEL_NAME）
DECISION_LLM_MODEL_NAME=
DECISION_LLM_TEMPERATURE=0.1
DECISION_LLM_MAX_TOKENS=768
REPORT_LLM_ENABLED=true
REPORT_LLM_SECTIONAL=true
REPORT_LLM_MAX_TOKENS=2560
REPORT_LLM_SECTION_MAX_TOKENS=1280
REPORT_PROMPT_MAX_INPUT_TOKENS=20000
REPORT_SECTION_PROMPT_MAX_INPUT_TOKENS=12000
REPORT_SECTION_MAX_BLOCKS=8
REPORT_SECTION_MAX_NOTES_PER_BLOCK=5
REPORT_SECTION_MAX_NOTES_TOTAL=36
REPORT_SECTION_MAX_CITATIONS=64
REPORT_REFERENCES_MAX_TOTAL=80
REPORT_REFERENCES_MAX_PER_SECTION=12
REPORT_CITATION_DOMAIN_ALLOWLIST=""
REPORT_CITATION_DOMAIN_DENYLIST=""
REPORT_CITATION_BLOCKED_TERMS=""
REPORT_CITATION_MIN_QUALITY_SCORE=0.9
REPORT_CITATION_MIN_QUERY_OVERLAP=0.06
REPORT_MIN_COMPLETED_BLOCKS=1
REPORT_MIN_PARAGRAPHS_TOTAL=6
REPORT_MIN_CITATION_PARAGRAPH_COVERAGE=0.2
REPORT_MIN_DISTINCT_CITATIONS=2
STRICT_FAIL_FAST=true

# DeepResearch 工具预算（提高多查询 + 网页深读能力）
MAX_TOOL_CALLS_PER_BLOCK=10
MAX_FOLLOWUP_QUERIES_PER_BLOCK=3
AGENT_DECISION_MAX_ROUNDS=3
AGENT_MIN_EVIDENCE_QUALITY_SCORE=60
AGENT_ACTION_BEAM_WIDTH=3
AGENT_ENABLE_CODE_EXEC_AUTO=true
AGENT_ACADEMIC_PAPER_FIRST=true
# false = follow-up 默认不直接扩树，先合并到当前 block 计划（生产推荐）
FOLLOWUP_QUEUE_EXPANSION_ENABLED=false
FOLLOWUP_PLAN_MAX_ITEMS=4
# false = 不根据摘要自动新增 follow-up block（生产推荐）
AUTO_EXPAND_FROM_SUMMARY=false
# true = 任一工具失败即中断当前 block（便于调试）
# false = 记录错误并继续执行其他证据通道（生产推荐）
AGENT_FAIL_FAST_ON_TOOL_ERROR=false
# false = follow-up 仅用于扩展队列，不直接拿来当 web/paper 搜索 query（生产推荐）
AGENT_USE_FOLLOWUP_AS_SEARCH_QUERY=false

# -------------------------------------------------------------------
# Section 4: ScholarMind RAG 核心配置
# -------------------------------------------------------------------
# 这些是我们在 config.py 中定义的应用核心配置，你可以在此覆盖默认值。

# 组件选择（当前建议 API 优先，local 仅用于未来扩展）
SM_EMBEDDER_TYPE="dashscope"
SM_RERANKER_TYPE="dashscope"
SM_LLM_TYPE="dashscope"

# 按任务拆分模型（推荐：回答用强模型，功能链路用小模型）
# 回答生成模型（例如 qwen3-max / qwen-max）
SM_LLM_MODEL_ANSWER="qwen3-max"
# 功能链路模型：翻译 / Multi-Query / HyDE（建议小模型）
SM_LLM_MODEL_AUX="qwen-turbo"
# 图谱抽取模型（可与 AUX 一致）
SM_LLM_MODEL_GRAPH="qwen-turbo"
# 对话摘要模型（可与 AUX 一致）
SM_LLM_MODEL_SUMMARY="qwen-turbo"
# LLM 请求超时（秒）
SM_LLM_REQUEST_TIMEOUT_SECS=60
SM_MAX_TOKENS=3072
SM_HISTORY_MAX_TOKENS=24000
SM_HISTORY_HEADROOM=12000
SM_CONTEXT_PACK_MAX_TOKENS=4096

# RAG 超参数
SM_RAG_TOPK=5
SM_RETRIEVE_PAGE_SIZE=5

# 精排熔断
SM_RERANKER_FAIL_MAX=3
SM_RERANKER_COOLDOWN_SECS=120
# 本地 reranker 失败时自动兜底到 DashScope（保证“可用可选”）
SM_RERANKER_FALLBACK_TO_DASHSCOPE=true
# DashScope 专用 reranker 模型
SM_DASHSCOPE_RERANK_MODEL="qwen3-rerank"

# 问答全链路超时（秒，<=0 表示不限制）
SM_ASK_TIMEOUT_SECS=120

# Ask SSE 回放（run_id + seq）缓存配置
# - 建议开启 Redis 持久化，支持服务重启后短时回放
SM_ASK_REPLAY_REDIS_ENABLED=true
SM_ASK_REPLAY_TTL_SECS=600
SM_ASK_REPLAY_MAX_RUNS=256
SM_ASK_REPLAY_MAX_EVENTS_PER_RUN=4096
SM_ASK_REPLAY_REDIS_SCAN_LIMIT=3000

# 读取链路稳态开关（默认不在读链路补 embedding，避免“长时间停在准备检索”）
SM_STM_EMBED_MISSING_ON_READ=false
SM_LTM_EMBED_MISSING_ON_READ=false

# 快速模式策略（默认关闭高成本步骤）
SM_FAST_MODE_AUTO_TRANSLATE=false
SM_FAST_MODE_MQ_NUM=1
SM_FAST_MODE_HYDE_ENABLED=false
SM_FAST_MODE_RERANK_ENABLED=false
SM_FAST_MODE_MAX_VARIANTS=1
SM_FAST_MODE_RECALL_SOURCES="bm25,vector"
SM_FAST_MODE_RECALL_MULTIPLIER=1
SM_FAST_MODE_CHANNEL_TOPK=12

# 图谱增强（深度模式）
SM_GRAPH_ENABLED=true
# 图谱无命中时是否回退为“实体 query 变体”
SM_GRAPH_ENTITY_VARIANT_FALLBACK=true

# HyDE 失败时是否启用模板兜底（保证 deep 模式可用）
SM_HYDE_FALLBACK_ENABLED=true

# 索引存在性缓存（秒）
SM_INDEX_EXISTS_CACHE_TTL=60

# Elasticsearch 检索超时治理（避免前端长时间无响应）
SM_ES_CLIENT_TIMEOUT_SECS=60
SM_ES_SEARCH_TIMEOUT_SECS=20
SM_ES_SEARCH_RETRY_TIMES=1

# Embedding 模型（远程模式下使用）
SM_EMBEDDING_MODEL="text-embedding-v3"
SM_EMBEDDING_DIMENSIONS=1024
SM_EMBEDDING_ENCODING_FORMAT="float"
SM_EMBEDDING_MAX_BATCH_SIZE=10

# 公式块是否独立成块（用于检索/上下文扩展）
SM_EQUATION_STANDALONE=true

# 本地模型路径 (如果使用 'local' 组件)
# 请根据你实际存放模型的位置修改这些路径。
LOCAL_EMBEDDER_PATH="/path/to/your/models/bge-large-zh-v1.5"
LOCAL_RERANKER_PATH="/path/to/your/models/bge-reranker-large"
LOCAL_LLM_PATH="/path/to/your/models/Qwen1.5-14B-Chat"

# 系统日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# -------------------------------------------------------------------
# Section 5: Doc Studio 微服务（本地开发时若单独启动 doc_studio 需配置）
# -------------------------------------------------------------------
# 主后端 URL，用于对话消息落库与加载。Docker 下默认 scholarmind_api:8000，本地开发请设为：
# RAG_SERVICE_URL=http://localhost:8000

# 语义检索（embedding 索引）：
# - provider=auto 时优先使用 DashScope key，否则回退 OpenAI key
# - model 留空时自动选择：dashscope -> text-embedding-v3，openai -> text-embedding-3-small
SEMANTIC_SEARCH_ENABLED=true
SEMANTIC_SEARCH_EMBED_PROVIDER=auto
SEMANTIC_SEARCH_EMBED_MODEL=
SEMANTIC_SEARCH_EMBED_BATCH_SIZE=24
SEMANTIC_SEARCH_INDEX_TTL_SECONDS=900
SEMANTIC_SEARCH_INDEX_PERSIST_ENABLED=true
SEMANTIC_SEARCH_INDEX_DIR=/tmp/doc_studio_semantic_index
SEMANTIC_SEARCH_INDEX_PERSIST_MIN_INTERVAL_SECONDS=30
SEMANTIC_SEARCH_MAX_FILE_BYTES=786432
SEMANTIC_SEARCH_MAX_CHUNKS_PER_FILE=120
SEMANTIC_SEARCH_CHUNK_LINES=36
SEMANTIC_SEARCH_CHUNK_OVERLAP_LINES=8
SEMANTIC_SEARCH_COLD_START_PREWARM_ENABLED=true
SEMANTIC_SEARCH_COLD_START_PREWARM_MAX_FILES=120
